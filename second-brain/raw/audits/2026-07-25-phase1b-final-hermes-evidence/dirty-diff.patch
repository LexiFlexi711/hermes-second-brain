+        """BLOCKER 8: AST import audit — no a0/analyst/strategy/testbot/trader,
+        Phase 1B store modules, or Interpreter-write imports in any frozen
+        Phase 1A Outcome Builder file."""
+        import ast
+        import os as _os
+
+        _BUILDER_DIR = _os.path.join(
+            _os.path.dirname(__file__), "..", "outcome_builder"
+        )
+        _PHASE1A_FILES = [
+            "__init__.py",
+            "contracts.py",
+            "l4_reader.py",
+            "ohlc_cache.py",
+            "calculator.py",
+            "guardrails.py",
+            "cli.py",
+        ]
+
+        _FORBIDDEN_MODULES = {
+            "a0",
+            "snapshot_readout",
+            "analyst",
+            "strategy",
+            "testbot",
+            "trader",
+            # Phase 1B store modules:
+            "outcome_store",
+            "store_cli",
+            "store_contracts",
+            "phase1a_adapter",
+            "canonical_json",
+            "outcome_identity",
+            # Interpreter write-modules:
+            "l3_snapshot_build",
+            "l4_snapshot_store",
+            "l4_filler",
+            "l4_runner",
+            "l4_inspector",
+        }
+
+        violations = []
+        for fname in _PHASE1A_FILES:
+            fpath = _os.path.join(_BUILDER_DIR, fname)
+            with open(fpath, "r", encoding="utf-8") as fh:
+                try:
+                    tree = ast.parse(fh.read(), filename=fname)
+                except SyntaxError as e:
+                    self.fail(f"Parse error in {fname}: {e}")
+
+            for node in ast.walk(tree):
+                if isinstance(node, ast.Import):
+                    for alias in node.names:
+                        top = alias.name.split(".")[0]
+                        if top in _FORBIDDEN_MODULES or any(
+                            token in alias.name for token in _FORBIDDEN_MODULES
+                        ):
+                            violations.append(
+                                f"{fname}: import {alias.name} (line {node.lineno})"
+                            )
+                elif isinstance(node, ast.ImportFrom):
+                    if node.module is None:
+                        continue
+                    top = node.module.split(".")[0]
+                    if top in _FORBIDDEN_MODULES or any(
+                        token in node.module for token in _FORBIDDEN_MODULES
+                    ):
+                        for alias in node.names:
+                            violations.append(
+                                f"{fname}: from {node.module} import "
+                                f"{alias.name} (line {node.lineno})"
+                            )
+
+        if violations:
+            self.fail(
+                "Forbidden imports found in Phase 1A files:\n"
+                + "\n".join(violations)
+            )
 
 
