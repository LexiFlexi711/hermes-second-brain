+"""Phase 1A → Phase 1B Adapter — hard validation, no silent defaults."""
+
+from outcome_builder.store_contracts import (
+    STORE_SCHEMA_VERSION, OUTCOME_CONTRACT_VERSION, SOURCE_POLICY, ALLOWED_WINDOWS,
+)
+from outcome_builder.outcome_identity import make_windows_hash, make_outcome_id
+from outcome_builder.contracts import OutcomeSchemaError
