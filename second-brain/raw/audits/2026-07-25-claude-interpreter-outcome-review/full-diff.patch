+
+def adapt_phase1a_to_store(phase1a_output: dict, windows: dict) -> dict:
+    """Transform Phase 1A build_output into Phase 1B store candidate.
+
+    Hard validation. No .get() defaults for required fields.
+    Missing/invalid → OutcomeSchemaError.
+    """
+    if not isinstance(phase1a_output, dict):
+        raise OutcomeSchemaError("phase1a_output must be dict")
+    if not isinstance(windows, dict) or not windows:
+        raise OutcomeSchemaError("windows must be non-empty dict")
+
+    # Validate windows against ALLOWED_WINDOWS
+    for w_name, w_sec in windows.items():
+        if w_name not in ALLOWED_WINDOWS:
+            raise OutcomeSchemaError(f"unknown window: {w_name}")
+        if w_sec != ALLOWED_WINDOWS[w_name]:
+            raise OutcomeSchemaError(f"window {w_name} seconds mismatch: {w_sec} != {ALLOWED_WINDOWS[w_name]}")
