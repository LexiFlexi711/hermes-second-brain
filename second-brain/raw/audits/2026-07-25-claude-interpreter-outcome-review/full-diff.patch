+class TestV2CanonicalRegression:
+    """Bewijs dat RC1 canonical bytes ongewijzigd blijven."""
+
+    def _cj(self, val):
+        from outcome_builder.canonical_json import canonical_json
+        return canonical_json(val)
+
+    def test_canonical_int_1(self): assert self._cj(1) == b'1'
+    def test_canonical_float_1_0(self): assert self._cj(1.0) == b'1'
+    def test_canonical_float_2_0(self): assert self._cj(2.0) == b'2'
+    def test_canonical_neg_zero(self): assert self._cj(-0.0) == b'0'
+    def test_canonical_float_1_5(self): assert self._cj(1.5) == b'1.5'
+    def test_canonical_float_neg_1_5(self): assert self._cj(-1.5) == b'-1.5'
+    def test_canonical_small_float(self): assert self._cj(0.0000001) == b'0.0000001'
+    def test_canonical_large_float(self): assert self._cj(1e20) == b'100000000000000000000'
+    def test_canonical_nested_no_string_quotes(self):
+        result = self._cj({"price": 1.5})
+        assert b'1.5' in result and b'"1.5"' not in result
+
