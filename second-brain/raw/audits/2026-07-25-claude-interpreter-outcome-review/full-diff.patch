+def _enumerate_snapshots(l4_base_dir: str, pair: str, since=None, until=None,
+                         count=None) -> List[dict]:
+    """Enumerate snapshots from L4 SQLite using frozen reader.
+
+    Only selects snapshot_id, pair, asof_ts from real snapshots table.
+    No completeness_status filter — completeness comes from Phase 1A build_output.
+    """
+    import glob as _glob
+    pair_dir = os.path.join(l4_base_dir, pair)
+    if not os.path.isdir(pair_dir):
+        raise OutcomeReadError(f"Pair directory not found: {pair_dir}")
+    db_files = sorted(_glob.glob(os.path.join(pair_dir, "*.sqlite")), reverse=True)
+    if not db_files:
+        raise OutcomeReadError(f"No SQLite files in {pair_dir}")
+    db_path = db_files[0]
+
+    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
+    try:
+        cur = conn.cursor()
+        where = ["pair = ?"]
+        params: list = [pair]
+        if since is not None:
+            where.append("asof_ts >= ?"); params.append(since)
+        if until is not None:
+            where.append("asof_ts <= ?"); params.append(until)
+        query = f"SELECT snapshot_id, asof_ts, pair FROM snapshots WHERE {' AND '.join(where)} ORDER BY asof_ts ASC"
+        if count is not None:
+            query += f" LIMIT {int(count)}"
+        cur.execute(query, params)
+        return [{"snapshot_id": r[0], "asof_ts": r[1], "pair": r[2]} for r in cur.fetchall()]
+    except sqlite3.OperationalError as e:
+        raise OutcomeReadError(f"SQLite error enumerating snapshots: {e}")
+    finally:
+        conn.close()
+
