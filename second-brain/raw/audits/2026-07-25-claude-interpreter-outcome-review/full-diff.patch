+
+        assert "outcome_builder.l4_reader" in imports, "store_cli must import frozen l4_reader"
+        assert "outcome_builder.ohlc_cache" in imports, "store_cli must import frozen ohlc_cache"
+        assert "outcome_builder.cli" in imports, "store_cli must import frozen cli"
+        assert "outcome_builder.contracts" in imports, "store_cli must import frozen contracts"
+
+        # Check store_cli has NO local reader definitions
+        with open(os.path.join(os.path.dirname(__file__), "..", "outcome_builder", "store_cli.py")) as f:
+            src = f.read()
+        assert "def read_snapshot_metadata" not in src, "store_cli must not define local read_snapshot_metadata"
+        assert "def read_live_cache" not in src, "store_cli must not define local read_live_cache"
+
+        # Check outcome_store.py imports frozen guardrail
+        with open(os.path.join(os.path.dirname(__file__), "..", "outcome_builder", "outcome_store.py")) as f:
+            tree2 = ast.parse(f.read())
+        store_imports = set()
+        for node in ast.walk(tree2):
+            if isinstance(node, ast.ImportFrom):
+                if node.module:
+                    store_imports.add(node.module)
+        assert "outcome_builder.guardrails" in store_imports, "outcome_store must import frozen guardrails"
+
+        # Check outcome_store has NO _scan_forbidden
+        with open(os.path.join(os.path.dirname(__file__), "..", "outcome_builder", "outcome_store.py")) as f:
+            src2 = f.read()
+        assert "def _scan_forbidden" not in src2, "outcome_store must not define _scan_forbidden"
+
+        # Check store_contracts imports from outcome_builder.contracts
+        with open(os.path.join(os.path.dirname(__file__), "..", "outcome_builder", "store_contracts.py")) as f:
+            tree3 = ast.parse(f.read())
+        ct_imports = set()
+        for node in ast.walk(tree3):
+            if isinstance(node, ast.ImportFrom):
+                if node.module == "outcome_builder.contracts":
+                    for alias in node.names:
+                        ct_imports.add(alias.name)
+        assert "OUTCOME_CONTRACT_VERSION" in ct_imports, "store_contracts must import OUTCOME_CONTRACT_VERSION"
+        assert "SOURCE_POLICY" in ct_imports, "store_contracts must import SOURCE_POLICY"
+        assert "ALLOWED_WINDOWS" in ct_imports, "store_contracts must import ALLOWED_WINDOWS"
+
+        # Check no backflow imports
+        forbidden_modules = {"a0_snapshot_readout", "analyst", "strategy", "testbot", "trader"}
+        for mod in ("outcome_builder.outcome_store", "outcome_builder.store_cli", "outcome_builder.store_contracts", "outcome_builder.phase1a_adapter"):
+            try:
+                m = __import__(mod)
+                if hasattr(m, "__file__") and m.__file__:
+                    with open(m.__file__) as f:
+                        tree_m = ast.parse(f.read())
+                    for node in ast.walk(tree_m):
+                        if isinstance(node, ast.ImportFrom):
+                            if node.module:
+                                parts = node.module.split(".")
+                                if any(fb in parts for fb in forbidden_modules):
+                                    pytest.fail(f"{mod} imports forbidden module: {node.module}")
+                        elif isinstance(node, ast.Import):
+                            for alias in node.names:
+                                if any(fb in alias.name for fb in forbidden_modules):
+                                    pytest.fail(f"{mod} imports forbidden: {alias.name}")
+            except ImportError:
+                pass
