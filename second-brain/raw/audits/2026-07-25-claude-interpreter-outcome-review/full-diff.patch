+    3. frozen read_live_cache(cache_dir, pair, "1m", now=now)
+    4. frozen build_output(snapshot, cache, windows, now)
+    5. adapt_phase1a_to_store(output, windows)
+    """
+    now = time.time()
+
+    # Determine pair from snapshot_id if not provided
+    if pair is None:
+        # snapshot_id format: PAIR-ts-...
+        pair = snapshot_id.split("-")[0] if "-" in snapshot_id else None
+        if not pair:
+            return None, f"Cannot determine pair from snapshot_id: {snapshot_id}"
+
+    try:
+        snapshot = _frozen_read_snapshot(l4_base_dir, pair, snapshot_id)
+    except OutcomeReadError as e:
+        return None, f"read_snapshot_metadata failed: {e}"
+
+    try:
+        cache = _frozen_read_cache(cache_dir, pair, "1m", now=now)
+    except OutcomeReadError as e:
