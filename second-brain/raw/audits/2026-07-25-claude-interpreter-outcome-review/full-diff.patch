+        "outcome_id": oid, "record_revision": rev,
+        "supersedes_record_id": supersedes, "created_at": f"2026-07-23T0{rev}:00:00Z",
+        "previous_record_hash": prev_hash,
+        "outcome_contract_version": 1, "store_schema_version": STORE_SCHEMA_VERSION,
+        "source_policy": "cache_for_recent_only",
+        "source_snapshot": {"pair": "ETHEUR", "snapshot_id": "ETHEUR-ts", "asof_ts": 1784807700},
