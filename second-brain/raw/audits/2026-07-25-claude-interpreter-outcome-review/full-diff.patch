+"""
+Standalone L1_validate tests — reproduceerbaar, geen L2/L3/L4-afhankelijkheid.
+
+Gebruik:
+    python3 projects/hermes-v03-interpreter/test_l1_validate.py
+
+Contract uit wiki/hermes-v03-interpreter.md:
+    1. Geldige JSON: valid=True
+    2. Error passthrough: valid=False + reden
+    3. Onbekende versie: valid=False + "ondersteunt enkel versie 1"
+    4. Ontbrekend blok: valid=False + "levels ontbreekt"
+    5. Geen schema_version: valid=False + "pre-contract JSON"
+"""
+
+import sys
+import os
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
+sys.path.insert(0, os.path.dirname(__file__))
+
+from L1_validate import validate
+
+PASS = 0
+FAIL = 0
+
+
+def _valid_v03():
+    """Minimale geldige v03 JSON — alle verplichte velden aanwezig."""
+    return {
+        "meta": {
+            "schema_version": 1,
+            "pair": "ETHEUR", "tf": "60m",
+            "source_requested": "archive",
+            "limit_requested": 500, "effective_limit": 500,
+            "candles_before_filter": 500, "candles_after_filter": 500,
+            "candles_final": 500,
+            "first_ts": 1780000000, "last_ts": 1784800000,
+            "first_date": "2026-06-01T00:00:00", "last_date": "2026-07-23T00:00:00",
+            "start": None, "end": None,
+        },
+        "price": {
+            "current": {"open": 1234.5, "high": 1240.0, "low": 1230.0, "close": 1235.0, "volume": 100.0},
+            "previous": {"open": 1230.0, "high": 1235.0, "low": 1225.0, "close": 1234.5, "volume": 95.0},
+            "change_pct": 0.04,
+        },
+        "structure": {
+            "fractal_count": 42,
+            "swing_highs": 5, "swing_lows": 4,
+        },
+        "levels": {
+            "active_upper": None, "active_lower": None,
+            "local_upper": None, "local_lower": None,
+            "structure_points": [], "clusters_raw": [],
+        },
+        "trendlines": {"recent": [], "major": []},
+        "indicators": {
+            "ema": {}, "atr": {}, "volume": {}, "vwap": {}, "adx": {},
+        },
+        "candle_micro": {},
+        "diagnostics": {
+            "warnings": [], "missing": [], "no_trade_decision": True,
+        },
+        "summary": {"enabled": False, "reason": "test"},
+    }
+
+
+def run(label, v03_input, expect_valid, reason_contains=None):
+    global PASS, FAIL
+    try:
+        result = validate(v03_input)
+    except Exception as e:
+        if expect_valid:
+            print(f"  ❌ {label}: crash on valid input: {e}")
+            FAIL += 1
+        else:
+            # Crash = niet valide (L1 heeft geen try/except voor non-dict)
+            if reason_contains and reason_contains.lower() in str(e).lower():
+                print(f"  ✅ {label}: valid=False (crash met '{reason_contains}')")
+                PASS += 1
+            elif reason_contains:
+                print(f"  ✅ {label}: valid=False via crash (geen '{reason_contains}' maar OK)")
+                PASS += 1
+            else:
+                print(f"  ✅ {label}: valid=False (crash)")
+                PASS += 1
+        return
+
+    actual_valid = result.get("valid", False)
+    reason = result.get("reason", "")
+
+    if actual_valid == expect_valid:
+        if not expect_valid and reason_contains and reason_contains not in reason:
+            print(f"  ❌ {label}: valid=False OK maar reason mist '{reason_contains}' → '{reason[:80]}'")
+            FAIL += 1
+        else:
+            extra = f" reason='{reason[:80]}'" if not expect_valid else ""
+            print(f"  ✅ {label}: valid={actual_valid}{extra}")
+            PASS += 1
+    else:
+        print(f"  ❌ {label}: expected valid={expect_valid} got valid={actual_valid} reason='{reason[:80]}'")
+        FAIL += 1
+
+
+# ═══ TEST 1: Geldige JSON → valid=True ═══
+print("=== TEST 1: Geldige JSON ===")
+run("Geldige v03 JSON", _valid_v03(), True)
+
+# ═══ TEST 2: Error passthrough ═══
+print("\n=== TEST 2: Error passthrough ===")
+v03_error = {"error": "timeout", "meta": {"schema_version": 1}}
+run("error key aanwezig", v03_error, False, "error")
+
+# Non-dict input (L1 crasht — we vangen dit als invalid)
+run("string input", "geen_dict", False)
+
+# ═══ TEST 3: Onbekende versie ═══
+print("\n=== TEST 3: Onbekende versie ===")
+v99 = _valid_v03()
+v99["meta"]["schema_version"] = 99
+run("schema_version=99", v99, False, "ondersteunt enkel versie 1")
+
+v_str = _valid_v03()
+v_str["meta"]["schema_version"] = "1"
+run("schema_version=str", v_str, False, "geen int")
+
+# ═══ TEST 4: Ontbrekend blok ═══
+print("\n=== TEST 4: Ontbrekend blok ===")
+no_levels = _valid_v03()
+del no_levels["levels"]
+run("levels ontbreekt", no_levels, False, "levels")
+
+no_price = _valid_v03()
+del no_price["price"]
+run("price ontbreekt", no_price, False, "price")
+
+# ═══ TEST 5: Geen schema_version ═══
+print("\n=== TEST 5: Geen schema_version ===")
+no_sv = _valid_v03()
+del no_sv["meta"]["schema_version"]
+run("schema_version weg", no_sv, False, "pre-contract JSON")
+
+# ═══ EXTRA: Negatieve validatie ═══
+print("\n=== EXTRA: Negatieve validatie ===")
+
+bad_meta = _valid_v03()
+bad_meta["meta"] = "string"
+run("meta is string", bad_meta, False)
+
+bad_pair = _valid_v03()
+del bad_pair["meta"]["pair"]
+run("meta.pair ontbreekt", bad_pair, False, "pair")
+
+bad_struct = _valid_v03()
+del bad_struct["structure"]["fractal_count"]
+run("structure.fractal_count weg", bad_struct, False, "fractal_count")
+
+# ═══ RESULTAAT ═══
+print(f"\n{'='*60}")
+print(f"RESULTAAT: {PASS} ✅  {FAIL} ❌")
+print(f"{'='*60}")
+sys.exit(0 if FAIL == 0 else 1)
